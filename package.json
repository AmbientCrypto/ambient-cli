{
  "name": "ambient-cli-workspace",
  "private": true,
  "version": "1.0.2",
  "description": "A standalone terminal coding agent for the Ambient decentralized-inference network.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmbientCrypto/ambient-cli.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
